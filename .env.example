# Copy to .env; generate PAYLOAD_SECRET locally. Never commit real credentials.
APP_ENV=local
DATABASE_KIND=sqlite
DATABASE_URL=file:./.data/local/payload.db
DATABASE_AUTH_TOKEN=
DATABASE_TARGET_HOST=
PAYLOAD_SECRET=
MEDIA_STORAGE=local
# Local media only; existing records retain their stored prefixes.
MEDIA_PREFIX=stark-poc/editorial
# Remote mode: APP_ENV=test, DATABASE_KIND=turso, MEDIA_STORAGE=r2.
# All R2 fields below are required in remote mode, including target confirmation.
R2_BUCKET=
R2_TARGET_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
R2_PREFIX=
# Set in an operator terminal only after reviewing the approved disposable target:
# MIGRATION_TARGET_HOST=<approved-test-hostname>
# BOOTSTRAP_TARGET_HOST=<approved-test-hostname>
